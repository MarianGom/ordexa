<div class="stack-6">

    <!-- HEADER -->
    <div class="row-between">

        <div>
            <h1 class="h1">Gestionar Usuarios</h1>
            <p class="sub">Administrá usuarios, roles y permisos del sistema</p>
        </div>

        <a href="/usuarios/create" class="btn btn-primary">
            <span class="btn__icon">＋</span>
            Nuevo usuario
        </a>

    </div>

    <!-- CARD TABLE -->
    <div class="card card--shadow-sm">

        <div class="list-toolbar">
            <form class="list-search" method="GET" action="/usuarios" role="search">
                <label for="buscar-usuario">Buscar usuario</label>
                <div class="list-search__controls">
                    <input
                        class="input"
                        id="buscar-usuario"
                        type="search"
                        name="q"
                        value="<%= q || '' %>"
                        placeholder="CUIL, nombre o apellido"
                        autocomplete="off">
                    <button class="btn btn-primary" type="submit">Buscar</button>
                    <% if (q) { %>
                        <a class="btn btn-outline" href="/usuarios">Limpiar</a>
                    <% } %>
                </div>
            </form>
        </div>

        <div class="card__content card__content--noPad">

            <div class="tablewrap">

                <table class="table">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>CUIL</th>
                            <th class="hide-md">Correo</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th class="right">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% if (usuarios && usuarios.length> 0) { %>

                            <% usuarios.forEach(u=> { %>

                                <tr>

                                    <td class="strong">
                                        <%= u.id_usuario %>
                                    </td>

                                    <td>
                                        <%= u.apellido %>, <%= u.nombre %>
                                    </td>

                                    <td>
                                        <%= u.cuil %>
                                    </td>

                                    <td class="hide-md">
                                        <%= u.correo %>
                                    </td>

                                    <td>
                                        <% const r=u.rol?.nombre || "" %>

                                            <% if (r==="administrador" ) { %>
                                                <span class="badge badge--st-red">Administrador</span>
                                                <% } else if (r==="operario" ) { %>
                                                    <span class="badge badge--st-blue">Operario</span>
                                                    <% } else if (r==="responsable" ) { %>
                                                        <span class="badge badge--st-yellow">Responsable</span>
                                                        <% } else { %>
                                                            <span class="badge badge--st-gray">
                                                                <%= r %>
                                                            </span>
                                                            <% } %>
                                    </td>

                                    <td>
                                        <% if (u.activo) { %>
                                            <span class="badge badge--st-green">Activo</span>
                                            <% } else { %>
                                                <span class="badge badge--st-red">Inactivo</span>
                                                <% } %>
                                    </td>

                                    <td class="right">

                                        <button class="iconbtn" type="button" data-menu-btn>
                                            …
                                        </button>

                                        <div class="menu v0-menu is-hidden" data-menu>

                                            <a class="menu__item" href="/usuarios/<%= u.id_usuario %>">
                                                👁 Ver
                                            </a>

                                            <a class="menu__item" href="/usuarios/<%= u.id_usuario %>/edit">
                                                ✏ Editar
                                            </a>

                                           <%
    const accion = u.activo ? 'desactivar' : 'activar';
    const textoBoton = u.activo ? '⛔ Desactivar' : '✅ Activar';
    const claseBoton = u.activo ? 'menu__item--danger' : '';
%>

<form
    method="POST"
    action="/usuarios/<%= u.id_usuario %>/delete"
    onsubmit="return confirm('¿Seguro que deseas <%= accion %> este usuario?')">

    <button
        class="menu__item <%= claseBoton %>"
        type="submit">

        <%= textoBoton %>

    </button>

</form>

                                        </div>

                                    </td>

                                </tr>

                                <% }) %>

                                    <% } else { %>

                                        <tr>
                                            <td colspan="7" class="empty">
                                                <%= q
                                                    ? `No se encontraron usuarios para “${q}”.`
                                                    : "No hay usuarios registrados." %>
                                            </td>
                                        </tr>

                                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<script>
    const GAP = 8;

    function closeAllMenus() {
        document.querySelectorAll("[data-menu]")
            .forEach(menu => menu.classList.add("is-hidden"));
    }

    function placeMenu(button, menu) {
        const buttonRect = button.getBoundingClientRect();
        let top = buttonRect.bottom + GAP;
        let left = buttonRect.right - menu.offsetWidth;

        left = Math.max(GAP, Math.min(left, window.innerWidth - menu.offsetWidth - GAP));

        if (top + menu.offsetHeight > window.innerHeight - GAP) {
            top = buttonRect.top - menu.offsetHeight - GAP;
        }

        top = Math.max(GAP, top);
        menu.style.top = `${top}px`;
        menu.style.left = `${left}px`;
    }

    document.querySelectorAll("[data-menu-btn]").forEach((button) => {
        const menu = button.parentElement.querySelector("[data-menu]");

        button.addEventListener("click", (event) => {
            event.stopPropagation();
            const estabaAbierto = !menu.classList.contains("is-hidden");
            closeAllMenus();

            if (!estabaAbierto) {
                menu.classList.remove("is-hidden");
                requestAnimationFrame(() => placeMenu(button, menu));
            }
        });
    });

    document.addEventListener("click", closeAllMenus);
    window.addEventListener("scroll", closeAllMenus, true);
    window.addEventListener("resize", closeAllMenus);
</script>
